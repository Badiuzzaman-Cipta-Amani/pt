---
import { ArrowRight, ArrowUpRight } from "@lucide/astro"
import { Image } from "astro:assets"
import type { Unit } from "@/data/units"

// Mist tile: logo, name, summary, then the actions pinned to the foot.
// `withProfile` adds the solid "Lihat profil" button (the /unit-usaha listing).

interface Props {
  unit: Unit
  delay?: number
  withProfile?: boolean
}

const { unit, delay = 0, withProfile = false } = Astro.props
const href = `/unit-usaha/${unit.slug}`
---

<article
  class="group flex flex-col bg-mist p-8 transition-colors duration-300 hover:bg-[#ececec]"
  data-reveal
  data-reveal-delay={delay}
>
  <a href={href} class={`logo-tile mx-auto ${unit.logoClass}`} aria-label={unit.name}>
    <Image src={unit.logo} alt="" densities={[1, 2]} />
  </a>
  <h3 class="t-card mt-8"><a href={href} class="hover:underline">{unit.name}</a></h3>
  <p class="t-body mt-3">{unit.summary}</p>
  {
    (withProfile || unit.website) && (
      <div class="mt-auto flex flex-wrap items-center gap-3 pt-8">
        {withProfile && (
          <a href={href} class="btn btn-ink px-5 py-2.5 text-sm">
            Lihat profil
            <ArrowRight class="arrow-right h-4 w-4" stroke-width={1.5} />
          </a>
        )}
        {unit.website && (
          <a
            href={unit.website}
            target="_blank"
            rel="noopener"
            class="btn btn-ghost-ink px-5 py-2.5 text-sm"
          >
            Kunjungi situs
            <ArrowUpRight class="arrow-up-right h-4 w-4" stroke-width={1.5} />
          </a>
        )}
      </div>
    )
  }
</article>
